{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/pricing", "destination": "/pricing.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
